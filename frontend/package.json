{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "jest",
    "test:once": "jest --watchAll=false",
    "test:coverage": "jest --coverage --watchAll=false",
    "test:unit": "jest --testMatch \"<rootDir>/src/**/*.unit.test.js?(x)\" --watchAll=false",
    "test:integration": "jest --testMatch \"<rootDir>/src/**/*.integration.test.js\" --watchAll=false",
    "test:mock": "jest --testMatch \"<rootDir>/src/**/*.mock.test.jsx\" --watchAll=false",
    "test:unit:login": "npm run test validateLogin.unit.test.js",
    "test:inte:login": "jest --testPathPatterns=integration/Login.integration.test.jsx",
    "test:mock:login": "npx jest LoginForm.mock.test.jsx",
    "test:unit:product": "npm run test validateProduct.unit.test.js",
    "test:inte:product": "jest --testPathPatterns=integration/products.integration.test.jsx",
    "test:unit:prf": "npm run test AddProductPopup.unit.test.jsx",
    "test:mock:product": "npx jest Products.mock.test.jsx",
    "test:unit:cv:pr": "npm run test:coverage -- validateProduct.unit.test.js AddProductPopup.test.jsx",
    "test:verbose": "jest --verbose --watchAll=false",
    "test:e2e": "cypress run",
    "test:e2eb": "npx cypress open"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "prop-types": "^15.8.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.5",
    "sass": "^1.93.2"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@eslint/js": "^9.36.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.0.4",
    "axios-mock-adapter": "^2.1.0",
    "babel-jest": "^30.2.0",
    "cypress": "^15.5.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-html-reporters": "^3.1.7",
    "vite": "^7.1.7",
    "whatwg-fetch": "^3.6.20"
  }
}
